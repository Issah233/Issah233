    STIG-ID         : WN11-CC-000090
    Documentation   : https://stigaview.com/products/win11/v2r7/WN11-CC-000090/

.TESTED ON
    Date(s) Tested  : 2026-05-26
    Tested By       : Issah Alhassan
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID- WN11-CC-000090 ).ps5
#>


# Run as Administrator

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Group Policy\{35378EAC-683F-11D2-A89A-00C04FBBCFA2}"

# Create registry path if missing
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Configure registry policy processing
New-ItemProperty `
    -Path $RegistryPath `
    -Name "NoGPOListChanges" `
    -Value 0 `
    -PropertyType DWord `
    -Force | Out-Null

Write-Host "Registry policy processing configured."
