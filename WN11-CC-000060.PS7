<#
.SYNOPSIS
This script ensures the system doesn’t maintain risky simultaneous connections that could expose the domain environment.
.NOTES
    Author          : Issah Alhassan 
    LinkedIn        : www.linkedin.com/in/issah-alhassan 
    GitHub          : https://github.com/Issah233
    Date Created    : 2026-05-26
    Last Modified   : 2026-05-26
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000060
    Documentation   : https://stigaview.com/products/win11/v2r7/WN11-CC-000060/

.TESTED ON
    Date(s) Tested  : 2026-05-26
    Tested By       : Issah Alhassan
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID-WN11-CC-000060).ps7
#>


# Run as Administrator

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WcmSvc\GroupPolicy"

# Create registry path if missing
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Block non-domain networks when connected to a domain authenticated network
New-ItemProperty `
    -Path $RegistryPath `
    -Name "fBlockNonDomain" `
    -Value 1 `
    -PropertyType DWord `
    -Force | Out-Null

Write-Host "Non-domain network connections blocked."
