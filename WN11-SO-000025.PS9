<#
.SYNOPSIS
This ensures that:
The default Guest account is not left with an obvious name
Attackers cannot easily identify or target it
It reduces the risk of unauthorized access attempts using a known account name

.NOTES
    Author          : Issah Alhassan 
    LinkedIn        : www.linkedin.com/in/issah-alhassan 
    GitHub          : https://github.com/Issah233
    Date Created    : 2026-05-26
    Last Modified   : 2026-05-26
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-SO-000025
    Documentation   : https://stigaview.com/products/win11/v2r7/WN11-SO-000025/

.TESTED ON
    Date(s) Tested  : 2026-05-26
    Tested By       : Issah Alhassan
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID-WN11-SO-000025).ps9
#>


# Run as Administrator
# Set new name for built-in Guest account
$NewGuestName = "DisabledGuest"

# Get the Guest account
$GuestAccount = Get-LocalUser -Name "Guest"

# Rename it
Rename-LocalUser -Name $GuestAccount.Name -NewName $NewGuestName

Write-Host "Guest account renamed to $NewGuestName"
    
