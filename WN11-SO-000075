# Run as Administrator
$RegistryPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"

# Create key if missing
if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Set banner caption (title)
New-ItemProperty `
    -Path $RegistryPath `
    -Name "LegalNoticeCaption" `
    -Value "WARNING" `
    -PropertyType String `
    -Force | Out-Null

# Set banner text (STIG required message)

New-ItemProperty `
    -Path $RegistryPath `
    -Name "LegalNoticeText" `
    -Value $BannerText `
    -PropertyType String `
    -Force | Out-Null

Write-Host "Logon banner configured successfully."

    
